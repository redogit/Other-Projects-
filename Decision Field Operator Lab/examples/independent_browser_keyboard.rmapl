GET ["boxes","$candidate","construction.state.layout.boxes"]
LEN ["bn","$boxes"]
CONST ["bi",0]
LABEL ["box_loop"]
LT ["box_more","$bi","$bn"]
JUMP_IF_FALSE ["$box_more","raster_done"]
INDEX ["box","$boxes","$bi"]
GET ["x","$box","x"]
GET ["y","$box","y"]
GET ["scale","$box","scale"]
GET ["text","$box","text"]
BYTES_UTF8 ["chars","$text"]
LEN ["cn","$chars"]
CONST ["ci",0]
LABEL ["char_loop"]
LT ["char_more","$ci","$cn"]
JUMP_IF_FALSE ["$char_more","next_box"]
BUF_GET ["code","$chars","$ci"]
INDEX ["glyph","$font","$code"]
CONST ["row",0]
LABEL ["row_loop"]
LT ["row_more","$row",7]
JUMP_IF_FALSE ["$row_more","next_char"]
INDEX ["bits","$glyph","$row"]
CONST ["col",0]
LABEL ["col_loop"]
LT ["col_more","$col",5]
JUMP_IF_FALSE ["$col_more","next_row"]
SUB ["shift",4,"$col"]
SHR ["shifted","$bits","$shift"]
BIT_AND ["on","$shifted",1]
JUMP_IF_FALSE ["$on","next_col"]
CONST ["sy",0]
LABEL ["sy_loop"]
LT ["sy_more","$sy","$scale"]
JUMP_IF_FALSE ["$sy_more","next_col"]
CONST ["sx",0]
LABEL ["sx_loop"]
LT ["sx_more","$sx","$scale"]
JUMP_IF_FALSE ["$sx_more","next_sy"]
MUL ["char_advance","$ci",6]
MUL ["char_advance","$char_advance","$scale"]
MUL ["col_advance","$col","$scale"]
ADD ["col_advance","$col_advance","$sx"]
ADD ["px","$x","$char_advance"]
ADD ["px","$px","$col_advance"]
MUL ["row_advance","$row","$scale"]
ADD ["row_advance","$row_advance","$sy"]
ADD ["py","$y","$row_advance"]
MUL ["pixel_index","$py","$width"]
ADD ["pixel_index","$pixel_index","$px"]
BUF_SET ["$pixels","$pixel_index",0]
ADD ["sx","$sx",1]
JUMP ["sx_loop"]
LABEL ["next_sy"]
ADD ["sy","$sy",1]
JUMP ["sy_loop"]
LABEL ["next_col"]
ADD ["col","$col",1]
JUMP ["col_loop"]
LABEL ["next_row"]
ADD ["row","$row",1]
JUMP ["row_loop"]
LABEL ["next_char"]
ADD ["ci","$ci",1]
JUMP ["char_loop"]
LABEL ["next_box"]
ADD ["bi","$bi",1]
JUMP ["box_loop"]
LABEL ["raster_done"]
SET ["$candidate","construction.state.camera.pixels","$pixels"]
CONST ["next_residual",[{"kind":"frame-verification-pending","detail":"raster-complete"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","raster-complete"]
END
OPERATOR browser_frame_verify
LIMIT 150000
BUFFER_LIMIT 1048576
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
GET ["pixels","$candidate","construction.state.camera.pixels"]
GET ["width","$candidate","construction.state.camera.width"]
GET ["height","$candidate","construction.state.camera.height"]
MUL ["expected","$width","$height"]
LEN ["actual","$pixels"]
EQ ["size_ok","$expected","$actual"]
JUMP_IF_FALSE ["$size_ok","fail"]
CONST ["i",0]
CONST ["black",0]
LABEL ["loop"]
LT ["more","$i","$actual"]
JUMP_IF_FALSE ["$more","count_done"]
BUF_GET ["p","$pixels","$i"]
EQ ["is_black","$p",0]
JUMP_IF_FALSE ["$is_black","next"]
ADD ["black","$black",1]
LABEL ["next"]
ADD ["i","$i",1]
JUMP ["loop"]
LABEL ["count_done"]
GT ["has_ink","$black",0]
JUMP_IF_FALSE ["$has_ink","fail"]
CONST ["true",true]
SET ["$candidate","construction.state.camera.verified","$true"]
SET ["$candidate","construction.state.camera.blackPixels","$black"]
CONST ["next_residual",[{"kind":"camera-pack-pending","detail":"frame-verified"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","frame-verified"]
LABEL ["fail"]
CONST ["false",false]
SET ["$candidate","construction.state.camera.verified","$false"]
CONST ["error_residual",[{"kind":"frame-verification-error","detail":"invalid-frame"}]]
SET ["$candidate","construction.residuals","$error_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","frame-verification-error"]
END
OPERATOR browser_camera_pack
LIMIT 2000
BUFFER_LIMIT 1048576
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
CONST ["header","P5\n160 64\n255\n"]
BYTES_UTF8 ["header_bytes","$header"]
GET ["pixels","$candidate","construction.state.camera.pixels"]
CONCAT ["pgm","$header_bytes","$pixels"]
SET ["$candidate","construction.state.camera.pgm","$pgm"]
CONST ["next_residual",[{"kind":"frame-admission-pending","detail":"camera-packed"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","camera-packed"]
END
OPERATOR browser_frame_admit
LIMIT 1000
BUFFER_LIMIT 1048576
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
CONST ["true",true]
SET ["$candidate","construction.state.camera.admitted","$true"]
CONST ["empty",[]]
SET ["$candidate","construction.residuals","$empty"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","frame-admitted"]
END
OPERATOR browser_pointer_activate
LIMIT 12000
BUFFER_LIMIT 65536
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
GET ["px","$candidate","construction.state.input.pointer.x"]
GET ["py","$candidate","construction.state.input.pointer.y"]
GET ["hits","$candidate","construction.state.hitMap"]
LEN ["n","$hits"]
CONST ["i",0]
LABEL ["loop"]
LT ["more","$i","$n"]
JUMP_IF_FALSE ["$more","miss"]
INDEX ["hit","$hits","$i"]
GET ["x","$hit","x"]
GET ["y","$hit","y"]
GET ["w","$hit","width"]
GET ["h","$hit","height"]
GE ["x_ge","$px","$x"]
ADD ["x2","$x","$w"]
LT ["x_lt","$px","$x2"]
AND ["in_x","$x_ge","$x_lt"]
GE ["y_ge","$py","$y"]
ADD ["y2","$y","$h"]
LT ["y_lt","$py","$y2"]
AND ["in_y","$y_ge","$y_lt"]
AND ["inside","$in_x","$in_y"]
JUMP_IF_FALSE ["$inside","next"]
GET ["href","$hit","href"]
SET ["$candidate","construction.state.navigation.pendingHref","$href"]
SET ["$candidate","construction.state.input.lastHit","$href"]
CONST ["next_residual",[{"kind":"local-navigation-pending","detail":"pointer-hit"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","pointer-hit"]
LABEL ["next"]
ADD ["i","$i",1]
JUMP ["loop"]
LABEL ["miss"]
CONST ["empty_text",""]
SET ["$candidate","construction.state.input.lastHit","$empty_text"]
CONST ["miss_residual",[{"kind":"pointer-no-target","detail":"no-hit"}]]
SET ["$candidate","construction.residuals","$miss_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","pointer-no-target"]
END
OPERATOR browser_local_navigate
LIMIT 16000
BUFFER_LIMIT 65536
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
GET ["target","$candidate","construction.state.navigation.pendingHref"]
GET ["pages","$candidate","construction.state.resources.pages"]
LEN ["n","$pages"]
CONST ["i",0]
LABEL ["loop"]
LT ["more","$i","$n"]
JUMP_IF_FALSE ["$more","missing"]
INDEX ["page","$pages","$i"]
GET ["id","$page","id"]
EQ ["match","$id","$target"]
JUMP_IF_FALSE ["$match","next"]
GET ["source","$page","source"]
GET ["current","$candidate","construction.state.navigation.currentPage"]
APPEND ["$candidate","construction.state.navigation.history","$current"]
SET ["$candidate","construction.state.navigation.currentPage","$target"]
CONST ["empty_text",""]
SET ["$candidate","construction.state.navigation.pendingHref","$empty_text"]
SET ["$candidate","construction.state.source","$source"]
CONST ["empty",[]]
SET ["$candidate","construction.state.html.tokens","$empty"]
SET ["$candidate","construction.state.dom.nodes","$empty"]
SET ["$candidate","construction.state.layout.boxes","$empty"]
SET ["$candidate","construction.state.hitMap","$empty"]
SET ["$candidate","construction.state.camera.pixels","$empty"]
SET ["$candidate","construction.state.camera.pgm","$empty"]
CONST ["false",false]
SET ["$candidate","construction.state.camera.verified","$false"]
SET ["$candidate","construction.state.camera.admitted","$false"]
CONST ["zero",0]
SET ["$candidate","construction.state.camera.blackPixels","$zero"]
CONST ["next_residual",[{"kind":"html-tokenization-pending","detail":"local-navigation"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","local-navigation"]
LABEL ["next"]
ADD ["i","$i",1]
JUMP ["loop"]
LABEL ["missing"]
CONST ["missing_residual",[{"kind":"navigation-target-missing","detail":"local-page-not-found"}]]
SET ["$candidate","construction.residuals","$missing_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","navigation-target-missing"]
END
OPERATOR browser_keyboard_activate
LIMIT 10000
BUFFER_LIMIT 65536
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
GET ["key","$candidate","construction.state.input.keyboard"]
GET ["hits","$candidate","construction.state.hitMap"]
LEN ["n","$hits"]
EQ ["is_tab","$key","TAB"]
JUMP_IF_FALSE ["$is_tab","check_enter"]
GT ["has_hits","$n",0]
JUMP_IF_FALSE ["$has_hits","no_target"]
GET ["focus","$candidate","construction.state.navigation.focusIndex"]
ADD ["focus","$focus",1]
MOD ["focus","$focus","$n"]
INDEX ["hit","$hits","$focus"]
GET ["href","$hit","href"]
SET ["$candidate","construction.state.navigation.focusIndex","$focus"]
SET ["$candidate","construction.state.navigation.focusedHref","$href"]
SET ["$candidate","construction.state.input.lastHit","$href"]
CONST ["empty",[]]
SET ["$candidate","construction.residuals","$empty"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","keyboard-focus"]
LABEL ["check_enter"]
EQ ["is_enter","$key","ENTER"]
JUMP_IF_FALSE ["$is_enter","unsupported"]
GET ["focus","$candidate","construction.state.navigation.focusIndex"]
CONST ["zero",0]
GE ["ge_zero","$focus","$zero"]
LT ["lt_n","$focus","$n"]
AND ["valid","$ge_zero","$lt_n"]
JUMP_IF_FALSE ["$valid","no_target"]
INDEX ["hit","$hits","$focus"]
GET ["href","$hit","href"]
SET ["$candidate","construction.state.navigation.pendingHref","$href"]
SET ["$candidate","construction.state.input.lastHit","$href"]
CONST ["minus_one",-1]
SET ["$candidate","construction.state.navigation.focusIndex","$minus_one"]
CONST ["empty_text",""]
SET ["$candidate","construction.state.navigation.focusedHref","$empty_text"]
CONST ["next_residual",[{"kind":"local-navigation-pending","detail":"keyboard-enter"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","keyboard-enter"]
LABEL ["no_target"]
CONST ["no_target_residual",[{"kind":"keyboard-no-target","detail":"no-focused-link"}]]
SET ["$candidate","construction.residuals","$no_target_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","keyboard-no-target"]
LABEL ["unsupported"]
CONST ["unsupported_residual",[{"kind":"keyboard-unsupported","detail":"unsupported-key"}]]
SET ["$candidate","construction.residuals","$unsupported_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","keyboard-unsupported"]
END
REPAIR activate-keyboard
WHEN "keyboard-activation-pending"
REQUIRES []
TARGETS ["keyboard-activation-pending"]
PRESERVES ["identity","claim-ceiling","provenance","evidence","sourceRefs"]
MAY_MUTATE ["state.input.lastHit","state.navigation.focusIndex","state.navigation.focusedHref","state.navigation.pendingHref","residuals"]
FORBIDS ["provenance","evidence","sourceRefs"]
APPLY browser_keyboard_activate
EVIDENCE []
COST 1
END

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redogit.github.io/Other-Projects-/knowledge-garden/catalog.schema.json",
  "title": "Knowledge Garden catalog",
  "description": "Structural format. Server validation additionally checks identity, references, cycles, source-access URLs and scoped support relations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "reviewed_on",
    "title",
    "scope",
    "rules",
    "nodes",
    "relations",
    "sources",
    "capabilities",
    "trails"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "trails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trail"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "parent_id",
        "summary",
        "status",
        "evidence_status",
        "source_ids",
        "tags",
        "next_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "group",
            "project",
            "component",
            "role"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_id",
        "to_id",
        "type",
        "scope",
        "status",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "related_to",
            "depends_on",
            "supports",
            "derived_from",
            "predecessor"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "source-described",
            "proposal"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "supports"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "source-described"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source_date",
        "reviewed_on",
        "access",
        "url",
        "evidence_kind",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "access": {
          "type": "string",
          "enum": [
            "public",
            "owner-held"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "evidence_kind": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "access": {
                "const": "owner-held"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_id",
        "name",
        "transport",
        "status",
        "invocation",
        "input",
        "output",
        "limitations",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": [
            "local-http",
            "external-browser",
            "source-contract"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "source-inspected",
            "described"
          ]
        },
        "invocation": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "local-http"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "implemented"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "external-browser"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "source-inspected"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "source-contract"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "described"
              }
            }
          }
        }
      ]
    },
    "trail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "node_ids",
        "next_action",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposal"
          ]
        }
      }
    }
  }
}

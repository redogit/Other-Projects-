    "claim_policy": "Claims stop at the strongest evidence actually carried by this repository; negative evidence and unresolved remainder are retained.",
    "selection_policy": "Selection is bounded, task-local, and minimal-necessity; unselected possibilities are not treated as false and selection does not imply global optimality.",
    "promotion": "evidence-gated and forward-only",
    "knowledge_decay": "Treat evidence age, accessibility, dependency drift, and changed external facts as active inputs when they can alter the current claim.",
    "historical_checkpoint_policy": "Do not rewrite verified predecessors merely to conform to newer lessons.",
    "required_distinctions": [
      "UNKNOWN != ABSENT",
      "UNASSIGNED != ABSENT",
      "UNSELECTED != FALSE",
      "INDEX_MISS != ABSENCE",
      "RELATED != SUPPORTS",
      "SEMANTIC_SIMILARITY != IDENTITY",
      "SOURCE != RECONSTRUCTION",
      "BYTE_IDENTITY != SEMANTIC_TRUTH",
      "CURRENT_NAVIGATION != HISTORICAL_SOURCE",
      "OBSERVATION != INTERPRETATION",
      "VIEWPOINT_CHANGE != TASK_CHANGE",
      "SELECTION != GLOBAL_OPTIMALITY",
      "FINITE_VERIFICATION != UNIVERSALITY",
      "LOSS_ACKNOWLEDGED != LOSS_CONCEALED",
      "EVALUATION_COMPLETE != PROMOTION_APPROVED",
      "PERSON != RECORDED_MODEL",
      "USER_GOAL != SYSTEM_GOAL",
      "PREDECESSOR != SUCCESSOR",
      "INTERNAL_CONSISTENCY != EXTERNAL_VALIDATION",
      "CLAIM != EVIDENCE"
    ],
    "domain_distinctions": [
      "BOUNDED_ACCESSION != ALL_HUMAN_EXPRESSION",
      "PRESERVATION != ENDORSEMENT",
      "SOURCE_RIGHTS != BLANKET_TRAINING_PERMISSION",
      "CORPUS_RECORD != INSTRUCTION",
      "SYNTHETIC_COMPRESSION_RESULT != LAW_OF_HUMAN_LEARNING",
      "EXACT_1024_BYTE_SECTION != UTF8_CHARACTER_BOUNDARY",

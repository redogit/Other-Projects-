MODULE rmaos.minigx.five_eyes_fermat_fire
SURFACE minigx
TARGET android.opengl_es_3_1

ENTITY Node.W114 KIND "MINIGX_NODE" FAMILY "STATE" OP "W114_CENTER" STAGE "0" PARAMS "degree=114;alpha=1,7,78,79,86,91;target=x1^6*x2^77*x3^78*x4^85*x5^90"
ENTITY Node.Fire KIND "MINIGX_NODE" FAMILY "FIELD" OP "FERMAT_FIRE" STAGE "1" PARAMS "ray_steps=48;quality_dynamic=true;palette=ember;vertex_shader=shaders/fullscreen.vert;shader=shaders/fermat_fire.frag"
ENTITY Node.FiveEyes KIND "MINIGX_NODE" FAMILY "OBSERVER" OP "FIVE_EYES" STAGE "2" PARAMS "count=5;simultaneous=true"
ENTITY Node.AllWays KIND "MINIGX_NODE" FAMILY "CONTROL" OP "ALL_WAYS" STAGE "2" PARAMS "ways=FORWARD,BACKWARD,UP,DOWN,SIDEWAYS,INWARD,OUTWARD,AROUND,THROUGH,REVERSE,BRANCH,HOMEWARD"
ENTITY Node.Branches KIND "MINIGX_NODE" FAMILY "GEOMETRY" OP "FRACTAL_BRANCHES" STAGE "3" PARAMS "depth=5;fanout=3"
ENTITY Node.Sparks KIND "MINIGX_NODE" FAMILY "POINT" OP "GPU_SPARKS" STAGE "3" PARAMS "count=96;feedback=0.91"
ENTITY Node.Cognates KIND "MINIGX_NODE" FAMILY "RELATION" OP "COGNATE_FILAMENTS" STAGE "3" PARAMS "boundary=COGNATE!=IDENTITY"
ENTITY Node.Audio KIND "MINIGX_NODE" FAMILY "SIGNAL" OP "PULSE_OSCILLATOR" STAGE "4" PARAMS "bpm=108;audio_optional=true"
ENTITY Node.Feedback KIND "MINIGX_NODE" FAMILY "FEEDBACK" OP "FRAME_FEEDBACK" STAGE "4" PARAMS "decay=0.94;mix=0.20"
ENTITY Node.Post KIND "MINIGX_NODE" FAMILY "POST" OP "BLOOM_TONEMAP" STAGE "5" PARAMS "bloom=1.15;exposure=1.10"
ENTITY Node.Trace KIND "MINIGX_NODE" FAMILY "TRACE" OP "TRACE_TAP" STAGE "6" PARAMS "schema=rmaos/minigx-trace/v1;authority=method-only"
ENTITY Node.Homeward KIND "MINIGX_NODE" FAMILY "STATE" OP "HOMEWARD" STAGE "6" PARAMS "recenter=true;preserve_trace=true"
ENTITY Node.Score KIND "MINIGX_NODE" FAMILY "GAME" OP "SURVIVOR_SCORE" STAGE "6" PARAMS "game_score_not_evidence=true"

RELATE Node.W114 AS FEEDS TO Node.Fire PORT "center"
RELATE Node.W114 AS FEEDS TO Node.FiveEyes PORT "object"
RELATE Node.AllWays AS MODULATES TO Node.Fire PORT "transform"
RELATE Node.AllWays AS MODULATES TO Node.FiveEyes PORT "orbit"
RELATE Node.Fire AS FEEDS TO Node.Branches PORT "field"
RELATE Node.Fire AS FEEDS TO Node.Sparks PORT "field"
RELATE Node.FiveEyes AS MODULATES TO Node.Cognates PORT "observer"
RELATE Node.Branches AS FEEDS TO Node.Post PORT "geometry"
RELATE Node.Sparks AS FEEDS TO Node.Post PORT "points"
RELATE Node.Cognates AS FEEDS TO Node.Post PORT "relations"
RELATE Node.Audio AS MODULATES TO Node.Fire PORT "pulse"
RELATE Node.Post AS FEEDS TO Node.Trace PORT "visual"
RELATE Node.AllWays AS FEEDS TO Node.Trace PORT "control"
RELATE Node.Cognates AS FEEDS TO Node.Trace PORT "relations"
RELATE Node.Homeward AS FEEDS TO Node.Trace PORT "return"
RELATE Node.Score AS FEEDS TO Node.Trace PORT "game"
RELATE Node.Feedback AS FEEDBACK_TO TO Node.Fire PORT "history"

CLAIM Boundary.GameScore KIND "BOUNDARY" STATUS "PRESERVED" TEXT "GAME_SCORE != MATHEMATICAL_EVIDENCE"
CLAIM Boundary.Cognate KIND "BOUNDARY" STATUS "PRESERVED" TEXT "COGNATE != IDENTITY"
CLAIM Boundary.GenerateVerifyAdmit KIND "BOUNDARY" STATUS "PRESERVED" TEXT "GENERATE != VERIFY != ADMIT"
CLAIM Boundary.SoftwareProof KIND "BOUNDARY" STATUS "PRESERVED" TEXT "SOFTWARE_VERIFICATION != MATHEMATICAL_PROOF"
CLAIM Boundary.Dimension KIND "BOUNDARY" STATUS "PRESERVED" TEXT "VISUAL_PROJECTION_ORBIT != MATHEMATICAL_DIMENSION"

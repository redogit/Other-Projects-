{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redogit.github.io/Other-Projects-/knowledge-garden/working-set.schema.json",
  "title": "Knowledge Garden working-set export format 2",
  "description": "New exports are source snapshots plus explicitly entered task text. The parser additionally checks a 1 MiB UTF-8 budget, stable unique IDs, closed source references, bounded nesting, and relation/capability endpoints. Imports are proposals, never executable instructions or evidence updates. The parser also accepts the original legacy 1.0.0 Garden proposal shape; this schema documents new format-2 exports. JavaScript field limits count UTF-16 code units; JSON Schema maxLength counts Unicode code points, so runtime limits can be stricter for non-BMP text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "format_version",
    "schema_version",
    "created_at",
    "catalog_version",
    "catalog_reviewed_on",
    "status",
    "title",
    "task",
    "scope",
    "navigation_note",
    "nodes",
    "relations",
    "capabilities",
    "sources",
    "rules"
  ],
  "properties": {
    "kind": {
      "const": "proposed-working-set"
    },
    "format_version": {
      "const": 2
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "catalog_reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "proposal"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "motivator",
        "request",
        "obligation",
        "surface",
        "output_definition"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "maxLength": 2000
        },
        "motivator": {
          "type": "string",
          "maxLength": 2000
        },
        "request": {
          "type": "string",
          "maxLength": 2000
        },
        "obligation": {
          "type": "string",
          "maxLength": 2000
        },
        "surface": {
          "type": "string",
          "maxLength": 2000
        },
        "output_definition": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "navigation_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "catalog.schema.json#/$defs/node"
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "catalog.schema.json#/$defs/relation"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "catalog.schema.json#/$defs/capability"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "catalog.schema.json#/$defs/source"
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      }
    }
  }
}

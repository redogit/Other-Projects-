RMAPL 0
PROGRAM independent-browser-interaction-v0
LOAD independent-browser-interaction-fixture
BOUND maxCandidates=1
BOUND maxSteps=1
OPERATOR browser_pointer_navigate
LIMIT 20000
BUFFER_LIMIT 1048576
METRICS {"residualReduction":1,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
GET ["hits","$candidate","construction.state.hitMap"]
GET ["click_x","$candidate","construction.state.input.clickX"]
GET ["click_y","$candidate","construction.state.input.clickY"]
LEN ["hn","$hits"]
CONST ["i",0]
LABEL ["loop"]
LT ["more","$i","$hn"]
JUMP_IF_FALSE ["$more","miss"]
INDEX ["hit","$hits","$i"]
GET ["x","$hit","x"]
GET ["y","$hit","y"]
GET ["width","$hit","width"]
GET ["height","$hit","height"]
ADD ["right","$x","$width"]
ADD ["bottom","$y","$height"]
GE ["inside_left","$click_x","$x"]
LT ["inside_right","$click_x","$right"]
GE ["inside_top","$click_y","$y"]
LT ["inside_bottom","$click_y","$bottom"]
AND ["inside_x","$inside_left","$inside_right"]
AND ["inside_y","$inside_top","$inside_bottom"]
AND ["inside","$inside_x","$inside_y"]
JUMP_IF_FALSE ["$inside","next"]
GET ["href","$hit","href"]
GET ["documents","$candidate","construction.state.documents"]
MAP_GET ["next_source","$documents","$href"]
GET ["location","$candidate","construction.state.location"]
APPEND ["$candidate","construction.state.history","$location"]
SET ["$candidate","construction.state.location","$href"]
SET ["$candidate","construction.state.source","$next_source"]
CONST ["empty",[]]
SET ["$candidate","construction.state.html.tokens","$empty"]
SET ["$candidate","construction.state.dom.nodes","$empty"]
SET ["$candidate","construction.state.layout.boxes","$empty"]
SET ["$candidate","construction.state.hitMap","$empty"]
SET ["$candidate","construction.state.camera.pixels","$empty"]
SET ["$candidate","construction.state.camera.pgm","$empty"]
CONST ["false",false]
SET ["$candidate","construction.state.camera.verified","$false"]
SET ["$candidate","construction.state.camera.admitted","$false"]
CONST ["zero",0]
SET ["$candidate","construction.state.camera.blackPixels","$zero"]
CONST ["true",true]
SET ["$candidate","construction.state.input.consumed","$true"]
CONST ["next_residual",[{"kind":"html-tokenization-pending","detail":"local-navigation"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","navigation-hit"]
LABEL ["next"]
ADD ["i","$i",1]
JUMP ["loop"]
LABEL ["miss"]
CONST ["true",true]
SET ["$candidate","construction.state.input.consumed","$true"]
CONST ["empty_residual",[]]
SET ["$candidate","construction.residuals","$empty_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","navigation-miss"]
END
REPAIR pointer-navigate
WHEN "pointer-input-pending"
REQUIRES []
TARGETS ["pointer-input-pending"]
PRESERVES ["identity","claim-ceiling","provenance","evidence","sourceRefs"]
MAY_MUTATE ["state.source","state.location","state.history","state.html.tokens","state.dom.nodes","state.layout.boxes","state.hitMap","state.camera.pixels","state.camera.pgm","state.camera.verified","state.camera.admitted","state.camera.blackPixels","state.input.consumed","residuals"]
FORBIDS ["provenance","evidence","sourceRefs"]
APPLY browser_pointer_navigate
EVIDENCE []
COST 1
END
RUN

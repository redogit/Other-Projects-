#version 310 es
precision highp float;
layout(location=0) out vec4 outColor;
uniform vec2 uResolution;uniform float uTime;uniform vec4 uControl;uniform vec2 uWay;uniform float uDigest;uniform int uRaySteps;uniform int uEyeCount;uniform int uSparkCount;uniform int uBranchCount;uniform float uBpm;uniform float uFeedback;uniform float uBloom;uniform float uExposure;
float h21(vec2 p){p=fract(p*vec2(123.34,345.45));p+=dot(p,p+34.345);return fract(p.x*p.y);}float h31(vec3 p){p=fract(p*.1031);p+=dot(p,p.yzx+33.33);return fract((p.x+p.y)*p.z);}mat2 r2(float a){float c=cos(a),s=sin(a);return mat2(c,-s,s,c);}float n3(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);float a=h31(i),b=h31(i+vec3(1,0,0)),c=h31(i+vec3(0,1,0)),d=h31(i+vec3(1,1,0)),e=h31(i+vec3(0,0,1)),g=h31(i+vec3(1,0,1)),h=h31(i+vec3(0,1,1)),j=h31(i+vec3(1,1,1));return mix(mix(mix(a,b,f.x),mix(c,d,f.x),f.y),mix(mix(e,g,f.x),mix(h,j,f.x),f.y),f.z);}float fbm(vec3 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*n3(p);p=p*2.03+vec3(13.1,7.7,3.3);a*=.5;}return v;}float seg(vec2 p,vec2 a,vec2 b){vec2 pa=p-a,ba=b-a;float t=clamp(dot(pa,ba)/max(dot(ba,ba),1e-5),0.,1.);return length(pa-ba*t);}vec3 palette(float x){return mix(vec3(.2,.03,.45),mix(vec3(1.,.16,.02),vec3(1.,.86,.27),smoothstep(.3,1.,x)),smoothstep(.05,.55,x));}
vec3 fire(vec2 uv,float t){vec3 ro=vec3(0.,-.15,3.2/uControl.z),rd=normalize(vec3(uv,-1.75));rd.yz=r2(uControl.y*.25)*rd.yz;rd.xz=r2(uControl.x*.3)*rd.xz;float trans=1.;vec3 col=vec3(0);int adaptive=int(mix(28.,48.,smoothstep(0.,1.,min(uResolution.x,uResolution.y)/900.))),steps=min(clamp(uRaySteps,1,64),adaptive);for(int i=0;i<64;i++){if(i>=steps)break;float z=float(i)*.075;vec3 p=ro+rd*z;p.xz=r2(t*.08*uWay.y+p.y*.09)*p.xz;float cone=length(p.xz)-(.5-.12*p.y),q=fbm(p*3.1+vec3(0.,-t*1.15,0.)),density=clamp(-cone*2.2+q*.82-.2,0.,1.);density*=smoothstep(-.85,-.25,p.y)*smoothstep(1.4,.05,p.y);density*=1.+uControl.w*1.9+uFeedback*.35;vec3 c=palette(density+q*.35);float a=density*.105;col+=trans*c*a;trans*=1.-a;if(trans<.03)break;}return col;}
vec3 eyes(vec2 uv,float t){vec3 c=vec3(0);for(int i=0;i<5;i++){if(i>=uEyeCount)break;float a=t*.19+float(i)*1.256637+uControl.x*.2;vec2 p=vec2(cos(a)*.72,sin(a)*.31);float d=length((uv-p)*vec2(1.,1.7)),ring=exp(-80.*abs(d-.06)),iris=exp(-100.*d*d);vec3 ec=.5+.5*cos(vec3(0.,2.,4.)+float(i)*1.3);c+=ec*(ring*.7+iris*.42);}return c;}
vec3 branches(vec2 uv,float t){vec3 c=vec3(0);for(int i=0;i<15;i++){if(i>=uBranchCount)break;float fi=float(i),level=floor(fi/3.),fan=mod(fi,3.)-1.;vec2 a=vec2(sin(level*1.7+t*.05)*.08*level,-.12+level*.11),b=a+vec2(fan*.09+sin(fi*2.1+t*.17)*.035,.18-level*.012);float d=seg(uv,a,b);c+=mix(vec3(1.,.22,.04),vec3(.58,.18,1.),fract(fi*.37))*exp(-150.*d)*(.18+.82*exp(-level*.16));}return c;}
vec3 cognates(vec2 uv,float t){vec3 c=vec3(0);float beat=t*(uBpm/60.)*6.28318530718;for(int i=0;i<11;i++){float fi=float(i);vec2 a=vec2(sin(fi*2.17+uDigest*7.)*.94,cos(fi*1.37)*.72),b=vec2(sin((fi+1.)*1.71)*.93,cos((fi+3.)*2.11)*.70);float d=seg(uv,a,b),pulse=.25+.75*pow(max(0.,sin(beat+fi+uWay.x*.4)),8.);c+=vec3(.12,.55,1.)*exp(-110.*d)*(.18+pulse*.62);c+=vec3(1.,.25,.05)*exp(-650.*length(uv-a))*pulse;}return c;}
vec3 sparks(vec2 uv,float t){vec3 c=vec3(0);for(int i=0;i<96;i++){if(i>=uSparkCount)break;float fi=float(i),seed=h21(vec2(fi,uDigest)),life=fract(t*(.08+.05*seed)+seed),a=fi*2.39996+uWay.x*.11,rr=life*(.25+1.15*seed);vec2 p=vec2(cos(a),sin(a))*rr+vec2(0.,-.12+life*.75);float d=length(uv-p);c+=mix(vec3(1.,.18,.03),vec3(.35,.75,1.),seed)*exp(-900.*d*d)*(1.-life);}return c;}
void main(){vec2 uv=(gl_FragCoord.xy-.5*uResolution)/uResolution.y;float t=uTime,rr=length(uv);vec3 col=vec3(.004,.002,.012);col+=fire(uv,t)+eyes(uv,t)+branches(uv,t)+cognates(uv,t)+sparks(uv,t);col+=exp(-8.*abs(rr-(.44+.03*sin(t*.4))))*.13*vec3(.45,.12,.9);col+=exp(-38.*dot(uv,uv))*vec3(1.2,.55,.08)*(1.+uControl.w*1.5+uFeedback*.4);col*=max(.1,uExposure);col+=max(col-vec3(.45),vec3(0.))*uBloom*.28;col=1.-exp(-col*1.35);col=pow(col,vec3(.82));outColor=vec4(col,1.);}

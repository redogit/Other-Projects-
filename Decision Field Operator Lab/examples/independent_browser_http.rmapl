RMAPL 0
PROGRAM independent-browser-http-v0
LOAD independent-browser-http-fixture
BOUND maxCandidates=1
BOUND maxSteps=1

OPERATOR browser_http_plan
LIMIT 12000
BUFFER_LIMIT 1048576
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
GET ["scheme","$candidate","construction.state.navigation.pendingUrl.scheme"]
EQ ["is_http","$scheme","http"]
JUMP_IF_FALSE ["$is_http","check_https"]
GET ["host","$candidate","construction.state.navigation.pendingUrl.authority"]
GET ["path","$candidate","construction.state.navigation.pendingUrl.path"]
CONST ["prefix","GET "]
CONCAT ["request","$prefix","$path"]
CONST ["protocol"," HTTP/1.1\r\nHost: "]
CONCAT ["request","$request","$protocol"]
CONCAT ["request","$request","$host"]
CONST ["headers","\r\nConnection: close\r\nAccept: text/html\r\nUser-Agent: RMAPL-Independent/0\r\n\r\n"]
CONCAT ["request","$request","$headers"]
BYTES_UTF8 ["request_bytes","$request"]
SET ["$candidate","construction.state.network.request.host","$host"]
CONST ["port",80]
SET ["$candidate","construction.state.network.request.port","$port"]
SET ["$candidate","construction.state.network.request.bytes","$request_bytes"]
CONST ["max_bytes",262144]
SET ["$candidate","construction.state.network.request.maxResponseBytes","$max_bytes"]
CONST ["transport_residual",[{"kind":"native-http-transport-pending","detail":"rmapl-request-ready"}]]
SET ["$candidate","construction.residuals","$transport_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","http-request-planned"]
LABEL ["check_https"]
EQ ["is_https","$scheme","https"]
JUMP_IF_FALSE ["$is_https","unsupported"]
CONST ["tls_residual",[{"kind":"tls-transport-pending","detail":"https-requires-native-tls-carrier"}]]
SET ["$candidate","construction.residuals","$tls_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","https-awaiting-tls"]
LABEL ["unsupported"]
CONST ["unsupported_residual",[{"kind":"network-scheme-unsupported","detail":"http-profile-only"}]]
SET ["$candidate","construction.residuals","$unsupported_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","network-scheme-unsupported"]
END

OPERATOR browser_http_response_admit
LIMIT 300000
BUFFER_LIMIT 1048576
METRICS {"residualReduction":0,"invariantPreservation":1,"reconstructibility":1,"reversibility":1,"evidenceCoverage":1,"branchReduction":0,"provenanceCompleteness":1,"semanticLoss":0,"ambiguityIntroduction":0,"relationGrowth":0,"runtimeCost":0,"economicCost":0,"unresolvedGrowth":0,"irreversibleMutation":0}
KNOWLEDGE_DECAY {"loss":[],"introduction":[],"aliasing":[],"ambiguity":[],"provenanceGap":[],"reconstructionCost":0,"oracleShift":[],"unresolvedGrowth":[]}
RECONSTRUCTION "exact"
CODE
CLONE ["candidate","$omega"]
GET ["response","$candidate","construction.state.network.responseBytes"]
LEN ["n","$response"]
GE ["enough","$n",17]
JUMP_IF_FALSE ["$enough","invalid"]
BUF_GET ["b","$response",0]
EQ ["s0","$b",72]
BUF_GET ["b","$response",1]
EQ ["s1","$b",84]
AND ["ok","$s0","$s1"]
BUF_GET ["b","$response",2]
EQ ["s2","$b",84]
AND ["ok","$ok","$s2"]
BUF_GET ["b","$response",3]
EQ ["s3","$b",80]
AND ["ok","$ok","$s3"]
BUF_GET ["b","$response",4]
EQ ["s4","$b",47]
AND ["ok","$ok","$s4"]
BUF_GET ["b","$response",5]
EQ ["s5","$b",49]
AND ["ok","$ok","$s5"]
BUF_GET ["b","$response",6]
EQ ["s6","$b",46]
AND ["ok","$ok","$s6"]
BUF_GET ["b","$response",7]
EQ ["s7","$b",49]
AND ["ok","$ok","$s7"]
BUF_GET ["b","$response",8]
EQ ["s8","$b",32]
AND ["ok","$ok","$s8"]
BUF_GET ["b","$response",9]
EQ ["s9","$b",50]
AND ["ok","$ok","$s9"]
BUF_GET ["b","$response",10]
EQ ["s10","$b",48]
AND ["ok","$ok","$s10"]
BUF_GET ["b","$response",11]
EQ ["s11","$b",48]
AND ["ok","$ok","$s11"]
BUF_GET ["b","$response",12]
EQ ["s12","$b",32]
AND ["ok","$ok","$s12"]
JUMP_IF_FALSE ["$ok","invalid"]
CONST ["i",13]
SUB ["scan_limit","$n",3]
LABEL ["scan_headers"]
LT ["more","$i","$scan_limit"]
JUMP_IF_FALSE ["$more","invalid"]
BUF_GET ["b0","$response","$i"]
EQ ["cr0","$b0",13]
JUMP_IF_FALSE ["$cr0","scan_next"]
ADD ["i1","$i",1]
BUF_GET ["b1","$response","$i1"]
EQ ["lf0","$b1",10]
JUMP_IF_FALSE ["$lf0","scan_next"]
ADD ["i2","$i",2]
BUF_GET ["b2","$response","$i2"]
EQ ["cr1","$b2",13]
JUMP_IF_FALSE ["$cr1","scan_next"]
ADD ["i3","$i",3]
BUF_GET ["b3","$response","$i3"]
EQ ["lf1","$b3",10]
JUMP_IF_FALSE ["$lf1","scan_next"]
ADD ["body_start","$i",4]
SUB ["body_len","$n","$body_start"]
GT ["body_ok","$body_len",0]
JUMP_IF_FALSE ["$body_ok","invalid"]
BUF_NEW ["body","$body_len",0]
CONST ["j",0]
LABEL ["copy_body"]
LT ["copy_more","$j","$body_len"]
JUMP_IF_FALSE ["$copy_more","body_done"]
ADD ["source_index","$body_start","$j"]
BUF_GET ["byte","$response","$source_index"]
BUF_SET ["$body","$j","$byte"]
ADD ["j","$j",1]
JUMP ["copy_body"]
LABEL ["body_done"]
TEXT_UTF8 ["html","$body"]
GET ["current","$candidate","construction.state.navigation.currentUrl.canonical"]
APPEND ["$candidate","construction.state.navigation.history","$current"]
GET ["pending","$candidate","construction.state.navigation.pendingUrl"]
SET ["$candidate","construction.state.navigation.currentUrl","$pending"]
CONST ["empty_url",{"raw":"","scheme":"","authority":"","path":"","canonical":"","kind":"","pageId":"","networkRequired":false}]
SET ["$candidate","construction.state.navigation.pendingUrl","$empty_url"]
CONST ["empty_text",""]
SET ["$candidate","construction.state.navigation.pendingHref","$empty_text"]
SET ["$candidate","construction.state.navigation.currentPage","$empty_text"]
SET ["$candidate","construction.state.source","$html"]
CONST ["status",200]
SET ["$candidate","construction.state.network.response.status","$status"]
SET ["$candidate","construction.state.network.response.bodyBytes","$body"]
CONST ["empty",[]]
SET ["$candidate","construction.state.html.tokens","$empty"]
SET ["$candidate","construction.state.dom.nodes","$empty"]
SET ["$candidate","construction.state.layout.boxes","$empty"]
SET ["$candidate","construction.state.hitMap","$empty"]
SET ["$candidate","construction.state.camera.pixels","$empty"]
SET ["$candidate","construction.state.camera.pgm","$empty"]
CONST ["false",false]
SET ["$candidate","construction.state.camera.verified","$false"]
SET ["$candidate","construction.state.camera.admitted","$false"]
CONST ["zero",0]
SET ["$candidate","construction.state.camera.blackPixels","$zero"]
CONST ["next_residual",[{"kind":"html-tokenization-pending","detail":"http-response-admitted"}]]
SET ["$candidate","construction.residuals","$next_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","http-response-admitted"]
LABEL ["scan_next"]
ADD ["i","$i",1]
JUMP ["scan_headers"]
LABEL ["invalid"]
CONST ["invalid_residual",[{"kind":"http-response-invalid","detail":"requires-http11-200-header-delimiter-utf8-body"}]]
SET ["$candidate","construction.residuals","$invalid_residual"]
OMEGA_REBUILD ["$candidate"]
RETURN ["$candidate","http-response-invalid"]
END

REPAIR plan-http
WHEN "network-transport-pending"
REQUIRES []
TARGETS ["network-transport-pending"]
PRESERVES ["identity","claim-ceiling","provenance","evidence","sourceRefs"]
MAY_MUTATE ["state.network.request.host","state.network.request.port","state.network.request.bytes","state.network.request.maxResponseBytes","residuals"]
FORBIDS ["provenance","evidence","sourceRefs"]
APPLY browser_http_plan
EVIDENCE []
COST 1
END

REPAIR admit-http-response
WHEN "http-response-parse-pending"
REQUIRES []
TARGETS ["http-response-parse-pending"]
PRESERVES ["identity","claim-ceiling","provenance","evidence","sourceRefs"]
MAY_MUTATE ["state.navigation.currentUrl","state.navigation.pendingUrl","state.navigation.pendingHref","state.navigation.currentPage","state.navigation.history","state.source","state.network.response.status","state.network.response.bodyBytes","state.html.tokens","state.dom.nodes","state.layout.boxes","state.hitMap","state.camera.pixels","state.camera.pgm","state.camera.verified","state.camera.admitted","state.camera.blackPixels","residuals"]
FORBIDS ["provenance","evidence","sourceRefs"]
APPLY browser_http_response_admit
EVIDENCE []
COST 1
END
RUN
